<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml" spacing="12" styleClass="dialog-root">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>
    <Label text="My loans" styleClass="title"/>
    <TableView fx:id="loansTable" prefHeight="300" accessibleText="Open loans">
        <columns>
            <TableColumn fx:id="isbnColumn" text="ISBN" prefWidth="140"/>
            <TableColumn fx:id="dueColumn" text="Due" prefWidth="110"/>
            <TableColumn fx:id="statusColumn" text="Status" prefWidth="90"/>
            <TableColumn fx:id="renewalsColumn" text="Renewals" prefWidth="90"/>
            <TableColumn fx:id="loanIdColumn" text="Loan ID" prefWidth="220"/>
        </columns>
    </TableView>
    <HBox spacing="10">
        <Button fx:id="refreshButton" text="_Refresh" mnemonicParsing="true"
                accessibleText="Refresh loans" onAction="#refresh"/>
        <Button fx:id="returnButton" text="_Return selected" mnemonicParsing="true"
                accessibleText="Return selected loan" onAction="#returnSelected"/>
        <Button fx:id="renewButton" text="Rene_w selected" mnemonicParsing="true"
                accessibleText="Renew selected loan" onAction="#renewSelected"/>
        <Button text="_Close" mnemonicParsing="true" accessibleText="Close loans desk"
                cancelButton="true" onAction="#close"/>
    </HBox>
    <Label fx:id="statusLabel" styleClass="status" text="Ready"/>
</VBox>
