<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml" spacing="12" styleClass="dialog-root">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>
    <Label text="Audit log" styleClass="title"/>
    <Label text="_Filter by action" mnemonicParsing="true" labelFor="$actionFilter"/>
    <HBox spacing="10">
        <TextField fx:id="actionFilter" promptText="Action (optional)"
                   accessibleText="Filter audit log by action" HBox.hgrow="ALWAYS"/>
        <Button fx:id="refreshButton" text="_Refresh" mnemonicParsing="true"
                accessibleText="Refresh audit log" onAction="#refresh"/>
    </HBox>
    <ListView fx:id="entriesList" prefHeight="300" accessibleText="Audit log entries"/>
    <HBox spacing="10">
        <Button text="_Close" mnemonicParsing="true" accessibleText="Close audit log"
                cancelButton="true" onAction="#close"/>
    </HBox>
    <Label fx:id="statusLabel" styleClass="status" text="Ready"/>
</VBox>
