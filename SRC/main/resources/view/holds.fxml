<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml" spacing="12" styleClass="dialog-root">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>
    <Label text="My holds" styleClass="title"/>
    <Label fx:id="selectedBookLabel" accessibleText="Selected catalog ISBN"/>
    <TableView fx:id="holdsTable" prefHeight="300" accessibleText="Current active holds">
        <columns>
            <TableColumn fx:id="isbnColumn" text="ISBN" prefWidth="140"/>
            <TableColumn fx:id="placedColumn" text="Placed" prefWidth="190"/>
            <TableColumn fx:id="statusColumn" text="Status" prefWidth="100"/>
            <TableColumn fx:id="expiresColumn" text="Expires" prefWidth="190"/>
        </columns>
    </TableView>
    <HBox spacing="10">
        <Button fx:id="refreshButton" text="_Refresh" mnemonicParsing="true"
                accessibleText="Refresh holds" onAction="#refresh"/>
        <Button fx:id="placeButton" text="_Place hold" mnemonicParsing="true"
                accessibleText="Place hold for selected catalog ISBN" onAction="#placeSelected"/>
        <Button text="_Close" mnemonicParsing="true" accessibleText="Close holds desk"
                cancelButton="true" onAction="#close"/>
    </HBox>
    <Label fx:id="statusLabel" styleClass="status" text="Ready"/>
</VBox>
