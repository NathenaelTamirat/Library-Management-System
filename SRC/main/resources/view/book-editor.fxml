<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml" spacing="16" styleClass="editor-panel">
    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>
    <Label fx:id="titleLabel" text="Add book" styleClass="editor-title"/>
    <GridPane hgap="12" vgap="12">
        <Label text="ISBN" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <TextField fx:id="isbnField" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
        <Label text="Title" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <TextField fx:id="titleField" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
        <Label text="Author" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
        <TextField fx:id="authorField" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
        <Label text="Copies" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
        <Spinner fx:id="copiesSpinner" editable="true" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
    </GridPane>
    <Label fx:id="errorLabel" styleClass="error"/>
    <HBox spacing="10">
        <Button fx:id="saveButton" text="Save" defaultButton="true" onAction="#save"/>
        <Button text="Cancel" cancelButton="true" onAction="#cancel"/>
    </HBox>
</VBox>
